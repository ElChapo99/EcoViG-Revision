# ==============================================================================
# SERVER-SIDE ENVIRONMENT VARIABLES (Google Cloud Run / Express Server only)
# 🔒 CRITICAL: Never expose these variables in Vite frontend (no VITE_ prefix).
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet backend is hosted on Cloud Run.
APP_URL="https://<URL_CLOUD_RUN_PRODUCTIVA>"

# RESEND_API_KEY: Server-side API key for sending transactional emails via Resend.
RESEND_API_KEY="REPLACE_WITH_RESEND_API_KEY"

# EMAIL_FROM: Official sender email address with display name for EcoVig notifications.
EMAIL_FROM="EcoVig <no-reply@ecovig.net>"

# AUTH_SECRET: Canonical server-side cryptographic secret for HMAC-SHA256 OTP hashing and reset session tokens.
AUTH_SECRET="REPLACE_WITH_STRONG_RANDOM_SERVER_SECRET"

# ==============================================================================
# CLIENT-SIDE ENVIRONMENT VARIABLES (Vite Frontend / Vercel Deployment)
# 🌐 Public variables exposed in browser bundle. No confidential secrets here.
# ==============================================================================

# VITE_API_BASE_URL: Optional direct backend URL override.
# When omitted, frontend uses relative "/api/..." and Vercel rewrites it via vercel.json.
# Example: "https://<SERVICE_URL>.run.app"
VITE_API_BASE_URL=""

# Optional Firebase Web Client variables for Vercel (automatically falls back to firebase-applet-config.json)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""
